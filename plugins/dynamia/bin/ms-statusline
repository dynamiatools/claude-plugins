#!/usr/bin/env bash
# ms-statusline: Claude Code status line that also records plan usage.
# Claude Code pipes a JSON document to this script on every update. For Pro/Max
# plans it contains rate_limits.five_hour / rate_limits.seven_day (percent used
# and reset time). We print a compact line and save a snapshot that
# `ms-workspace usage` reads, because there is no CLI to query usage directly.
#
# Enable it in settings.json:  "statusLine": { "type": "command", "command": "ms-statusline" }
# Env: MS_CACHE_DIR (default ~/.cache/ms-workspace)
set -u
command -v jq >/dev/null 2>&1 || { echo "ms-statusline: jq missing"; exit 0; }
input="$(cat)"
CACHE_DIR="${MS_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/ms-workspace}"
mkdir -p "$CACHE_DIR" 2>/dev/null || true

IFS=$'\t' read -r model cwd cost ctx p5 r5 p7 r7 sid < <(jq -r '[
    (.model.display_name // "?"),
    (.workspace.current_dir // .cwd // "-"),
    (.cost.total_cost_usd | if type == "number" then (. * 100 | round) else "-" end),
    (.context_window.used_percentage // "-"),
    (.rate_limits.five_hour.used_percentage // "-"), (.rate_limits.five_hour.resets_at // "-"),
    (.rate_limits.seven_day.used_percentage // "-"), (.rate_limits.seven_day.resets_at // "-"),
    (.session_id // "-")
  ] | map(tostring) | @tsv' <<<"$input" 2>/dev/null) || exit 0

now="$(date +%s)"

if [[ "$p5" != "-" || "$p7" != "-" ]]; then
  snap="$CACHE_DIR/usage.json"; tmp="$snap.$$"
  jq -n --argjson now "$now" --arg p5 "$p5" --arg r5 "$r5" --arg p7 "$p7" --arg r7 "$r7" '
    def num($x): if $x == "-" then null else ($x | tonumber) end;
    def win($p; $r): if $p == "-" then null else {used_percentage: num($p), resets_at: num($r)} end;
    {captured_at: $now, five_hour: win($p5; $r5), seven_day: win($p7; $r7)}' > "$tmp" 2>/dev/null \
    && mv "$tmp" "$snap" || rm -f "$tmp"
  # History sample at most once a minute, for pace calculations.
  marker="$CACHE_DIR/.last-sample"
  if [[ -z "$(find "$marker" -mmin -1 2>/dev/null)" ]]; then
    : > "$marker"
    jq -cn --argjson t "$now" --arg p5 "$p5" --arg p7 "$p7" \
      '{t:$t, u5:($p5|tonumber? // null), u7:($p7|tonumber? // null)}' >> "$CACHE_DIR/usage-history.jsonl" 2>/dev/null
    [[ "$(wc -l < "$CACHE_DIR/usage-history.jsonl" 2>/dev/null || echo 0)" -gt 4000 ]] \
      && tail -n 2000 "$CACHE_DIR/usage-history.jsonl" > "$CACHE_DIR/h.$$" && mv "$CACHE_DIR/h.$$" "$CACHE_DIR/usage-history.jsonl"
  fi
fi

color() { # pct -> ansi color (green < 70 <= yellow < 90 <= red); nothing when NO_COLOR is set
  [[ -n "${NO_COLOR:-}" ]] && return
  local p="${1%%.*}"
  if   [[ "$p" -ge 90 ]]; then printf '\033[31m'
  elif [[ "$p" -ge 70 ]]; then printf '\033[33m'
  else printf '\033[32m'; fi
}

# Git state of the session's directory: branch (short hash when detached), uncommitted files, ahead/behind upstream.
# Cached for MS_GIT_CACHE_SECS (default 5) seconds per directory so a big repo is not scanned on every refresh. Nothing is printed outside a repo.
branch=""; dirty=0; ahead=0; behind=0
if [[ "$cwd" != "-" && -d "$cwd" ]]; then
  gcache="$CACHE_DIR/git-$(printf '%s' "$cwd" | cksum | cut -d' ' -f1)"
  mtime="$(stat -c %Y "$gcache" 2>/dev/null || echo 0)"
  if [[ $(( now - mtime )) -lt ${MS_GIT_CACHE_SECS:-5} && -s "$gcache" ]]; then
    IFS=$'\t' read -r branch dirty ahead behind < "$gcache"
  else
    export GIT_OPTIONAL_LOCKS=0
    branch="$(git -C "$cwd" symbolic-ref --short -q HEAD 2>/dev/null || git -C "$cwd" rev-parse --short HEAD 2>/dev/null)" || branch=""
    if [[ -n "$branch" ]]; then
      dirty="$(git -C "$cwd" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
      read -r behind ahead < <(git -C "$cwd" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null) || { behind=0; ahead=0; }
      printf '%s\t%s\t%s\t%s\n' "$branch" "${dirty:-0}" "${ahead:-0}" "${behind:-0}" > "$gcache.$$" 2>/dev/null && mv "$gcache.$$" "$gcache"
    fi
  fi
fi

# Colors are off when NO_COLOR is set (https://no-color.org).
if [[ -n "${NO_COLOR:-}" ]]; then c() { :; }; reset=""; else c() { printf '\033[%sm' "$1"; }; reset=$'\033[0m'; fi

# THANOS badge: shown while a mission is attached to this session (the pointer is written by `ms-workspace thanos`; ignored when 12 h old).
badge=""
tfile="$CACHE_DIR/thanos/${sid//[^A-Za-z0-9_-]/}.json"
if [[ "$sid" != "-" && -f "$tfile" && -z "$(find "$tfile" -mmin +720 2>/dev/null)" ]]; then
  case "$(jq -r '.status // empty' "$tfile" 2>/dev/null)" in
    working) label="[THANOS IS WORKING]"; style='1;97;48;2;110;50;160' ;;   # white bold on Thanos purple
    paused)  label="[THANOS PAUSED]";     style='1;30;48;2;230;160;30' ;;
    done)    label="[THANOS DONE]";       style='1;97;48;2;30;130;60' ;;
    *)       label="" ;;
  esac
  if [[ -n "$label" ]]; then
    if [[ -n "${NO_COLOR:-}" ]]; then badge="$label "; else badge="$(c "$style")$label$reset "; fi
  fi
fi

out="$badge$(c 36)[$model]$reset"
if [[ -n "$branch" ]]; then
  out+=" $(c 35)⎇ $branch$reset"
  [[ "${dirty:-0}" -gt 0 ]] && out+=" $(c 33)●$dirty$reset"
  [[ "${ahead:-0}" -gt 0 ]] && out+=" $(c 32)↑$ahead$reset"
  [[ "${behind:-0}" -gt 0 ]] && out+=" $(c 31)↓$behind$reset"
fi
[[ "$ctx" != "-" ]] && out+=" ctx $(color "$ctx")${ctx%%.*}%${reset}"
[[ "$cost" != "-" ]] && out+=" $(c 2)$(printf '$%d.%02d' $((cost / 100)) $((cost % 100)))$reset"
if [[ "$p5" != "-" ]]; then
  left=$(( r5 - now )); [[ $left -lt 0 ]] && left=0
  out+=" | 5h $(color "$p5")${p5%%.*}%${reset} ($((left/3600))h$(( (left%3600)/60 ))m)"
fi
[[ "$p7" != "-" ]] && out+=" | 7d $(color "$p7")${p7%%.*}%${reset}"
printf '%s\n' "$out"
