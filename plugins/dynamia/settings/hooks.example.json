{
  "statusLine": {
    "type": "command",
    "command": "ms-statusline"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ms-workspace guard",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "ms-workspace readguard",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "ms-workspace context",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "ms-workspace readguard --reset",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ms-workspace images capture",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "ms-workspace handoff --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ms-workspace images capture",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "ms-workspace handoff --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ms-workspace outguard",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ms-workspace handoff --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ms-workspace notify --hook",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ms-workspace status:*)",
      "Bash(ms-workspace context:*)",
      "Bash(ms-workspace log:*)",
      "Bash(ms-workspace affected:*)",
      "Bash(ms-workspace usage:*)",
      "Bash(ms-workspace insights:*)",
      "Bash(ms-workspace tokens:*)",
      "Bash(ms-workspace memory:*)",
      "Bash(ms-workspace dev-env list:*)",
      "Bash(ms-workspace doctor:*)",
      "Bash(ms-workspace images:*)",
      "Bash(ms-workspace claude-md:*)",
      "Bash(ms-workspace plan:*)",
      "Bash(ms-workspace test:*)",
      "Bash(ms-workspace integrate:*)",
      "Bash(ms-workspace batch new:*)",
      "Bash(ms-workspace agent new:*)",
      "Bash(ms-workspace budget:*)",
      "Bash(ms-workspace http list:*)",
      "Bash(ms-workspace http history:*)",
      "Bash(ms-workspace http show:*)",
      "Bash(ms-workspace http diff:*)",
      "Bash(ms-workspace mock start:*)",
      "Bash(ms-workspace mock stop:*)",
      "Bash(ms-workspace mock status:*)",
      "Bash(ms-workspace mock url:*)",
      "Bash(ms-workspace mock list:*)",
      "Bash(ms-workspace mock requests:*)",
      "Bash(ms-workspace mock assert:*)",
      "Bash(ms-workspace docker status:*)",
      "Bash(ms-workspace docker logs:*)",
      "Bash(ms-workspace docker stats:*)",
      "Bash(ms-workspace docker disk:*)",
      "Bash(ms-workspace docker health:*)",
      "Bash(ms-workspace docker ports:*)",
      "Bash(ms-workspace docker env:*)",
      "Bash(ms-workspace docker wait:*)",
      "Bash(ms-workspace sys:*)",
      "Bash(ms-workspace ps)",
      "Bash(ms-workspace ps --:*)",
      "Bash(ms-workspace ps tree:*)",
      "Bash(ms-workspace ps find:*)",
      "Bash(ms-workspace ps ports:*)",
      "Bash(ms-workspace ps leftovers:*)",
      "Bash(ms-workspace handoff:*)",
      "Bash(ms-workspace gate:*)",
      "Bash(ms-workspace junit:*)",
      "Bash(ms-workspace modules:*)",
      "Bash(ms-workspace recall:*)",
      "Bash(ms-workspace release:*)"
    ],
    "ask": [
      "Bash(ms-workspace ship:*)",
      "Bash(ms-workspace promote:*)",
      "Bash(ms-workspace clean:*)",
      "Bash(ms-workspace env:*)",
      "Bash(ms-workspace open:*)",
      "Bash(ms-workspace setup-hooks:*)",
      "Bash(ms-workspace undo:*)",
      "Bash(ms-workspace http run:*)",
      "Bash(ms-workspace http bench:*)",
      "Bash(ms-workspace docker clean:*)",
      "Bash(ms-workspace ps kill:*)",
      "Bash(ms-workspace notify:*)",
      "Bash(ms-workspace dev-env add:*)",
      "Bash(ms-workspace dev-env rm:*)"
    ]
  }
}
