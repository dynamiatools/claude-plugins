#!/usr/bin/env python3
"""Safe MySQL / Percona Server / MariaDB tool. Python 3.11+, standard library only.

Talks to the server through the mysql (or mariadb) client binary. Passwords never appear in
argv, in the output or in this tool's config: a profile names a secret, the secret lives in
~/.config/dynamia-mysql/secrets.env (mode 600), and the client reads it from a temporary
0600 option file that is deleted right after.

  mysql-tool profiles | secrets
  mysql-tool secret-set NAME            prompts for the value (run it yourself with '! ')
  mysql-tool secret-gen NAME [--length N] [--force]
  mysql-tool info|inspect|replica-status PROFILE [--json] [--max-lag N]
  mysql-tool query PROFILE "SELECT ..."      read-only: one SELECT/SHOW/DESCRIBE/EXPLAIN SELECT
  mysql-tool exec PROFILE "SQL; SQL"         only the replication-setup statements in WRITE_OK
  mysql-tool plan-replica --source P --replica P --method xtrabackup|mariabackup|clone|dump
  mysql-tool diagnose REPLICA --source P     why a replica is broken and the safe way out
  mysql-tool plan-failover --candidate P [--old-source P] [--other P ...]
  mysql-tool backup P --method xtrabackup|mariabackup|dump --target DIR [--dry-run]
  mysql-tool verify-backup DIR
  mysql-tool audit-config|audit-accounts|slow-queries|locks|upgrade-check P
  mysql-tool schema-diff --a P --b P [--schema NAME]
  mysql-tool monitor P [P ...] [--max-lag N]  one line per server, exit 1 on any problem
  mysql-tool scan-secrets [PATH ...]          finds passwords left in files, never prints them

SQL text may contain '@@ENV:NAME@@', replaced at run time by the escaped secret NAME.
Destructive statements are never run by this tool.
"""
import argparse
import getpass
import json
import os
import re
import secrets as _secrets
import shutil
import string
import subprocess
import sys
import tempfile
import tomllib

MIN_MYSQL = (8, 4)
MIN_MARIADB = (10, 11)
HOME = lambda: os.environ.get("DYNAMIA_MYSQL_HOME") or os.path.join(os.path.expanduser("~"), ".config", "dynamia-mysql")


class Fail(Exception):
    pass


# ---- secrets and profiles -------------------------------------------------------------------

def secrets_path():
    return os.path.join(HOME(), "secrets.env")


def load_secrets():
    p = secrets_path()
    if not os.path.exists(p):
        return {}
    if os.stat(p).st_mode & 0o077:
        raise Fail("%s must not be readable by group or others (chmod 600)" % p)
    out = {}
    with open(p, encoding="utf-8") as fh:
        for line in fh.read().split("\n"):
            if line.strip() and not line.lstrip().startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                out[k.strip()] = v
    return out


def store_secret(name, value, force=False):
    if not re.fullmatch(r"[A-Z][A-Z0-9_]*", name):
        raise Fail("secret names are UPPER_SNAKE_CASE")
    if "\n" in value or not value:
        raise Fail("secret must be a single non-empty line")
    cur = load_secrets()
    if name in cur and not force:
        raise Fail("%s already exists (use --force to replace it)" % name)
    cur[name] = value
    os.makedirs(HOME(), mode=0o700, exist_ok=True)
    fd = os.open(secrets_path(), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("".join("%s=%s\n" % kv for kv in sorted(cur.items())))


def load_profiles():
    p = os.path.join(HOME(), "profiles.toml")
    if not os.path.exists(p):
        raise Fail("no profiles: create %s (see the connect skill)" % p)
    with open(p, "rb") as fh:
        profiles = tomllib.load(fh).get("profiles", {})
    for name, prof in profiles.items():
        bad = [k for k in prof if "pass" in k.lower() or "pwd" in k.lower()]
        if bad:
            raise Fail("profile %s has %s: passwords never go in the profile; use secret = \"NAME\"" % (name, bad[0]))
    return profiles


def get_profile(name):
    profiles = load_profiles()
    if name not in profiles:
        raise Fail("unknown profile %r; known: %s" % (name, ", ".join(sorted(profiles)) or "none"))
    return profiles[name]


# ---- running the client ---------------------------------------------------------------------

def sql_literal(value):
    return value.replace("\\", "\\\\").replace("'", "''")


def fill_placeholders(sql):
    store = None

    def sub(m):
        nonlocal store
        store = load_secrets() if store is None else store
        if m.group(1) not in store:
            raise Fail("secret %s is not set (user: ! mysql-tool secret-set %s)" % (m.group(1), m.group(1)))
        return sql_literal(store[m.group(1)])
    return re.sub(r"@@ENV:([A-Z][A-Z0-9_]*)@@", sub, sql)


def redact(text, extra=()):
    values = [v for v in list(load_secrets().values()) + list(extra) if len(v) >= 4]
    for v in sorted(values, key=len, reverse=True):
        text = text.replace(v, "***")
    text = re.sub(r"(?i)((?:source|master)_password\s*=\s*)'(?:[^'\\]|\\.|'')*'", r"\1'***'", text)
    return re.sub(r"(?i)(identified\s+(?:with\s+\w+\s+)?by\s+)'(?:[^'\\]|\\.|'')*'", r"\1'***'", text)


def client_binary(prof):
    for name in ([prof["client"]] if prof.get("client") else ["mysql", "mariadb"]):
        if shutil.which(name):
            return shutil.which(name)
    raise Fail("no mysql or mariadb client binary found in PATH")


def run_sql(prof, sql, readonly=True, timeout=60):
    """Runs sql through the client over stdin. Returns stdout. Raises Fail with a redacted message."""
    binary = client_binary(prof)
    pw = None
    if prof.get("secret"):
        pw = load_secrets().get(prof["secret"])
        if pw is None:
            raise Fail("secret %s is not set (user: ! mysql-tool secret-set %s)" % (prof["secret"], prof["secret"]))
    cnf = None
    args = [binary]
    try:
        if pw is not None or prof.get("login_path"):
            if prof.get("login_path"):
                args.append("--login-path=%s" % prof["login_path"])
            else:
                d = os.path.join(HOME(), "tmp")
                os.makedirs(d, mode=0o700, exist_ok=True)
                fd, cnf = tempfile.mkstemp(dir=d, suffix=".cnf")
                with os.fdopen(fd, "w") as fh:
                    esc = pw.replace("\\", "\\\\").replace('"', '\\"')
                    fh.write('[client]\npassword="%s"\n' % esc)
                args.insert(1, "--defaults-extra-file=%s" % cnf)
        args += ["--batch", "--connect-timeout=10", "--default-character-set=utf8mb4",
                 "--host=%s" % prof.get("host", "127.0.0.1"), "--port=%s" % prof.get("port", 3306),
                 "--user=%s" % prof["user"]]
        if prof.get("socket"):
            args += ["--socket=%s" % prof["socket"]]
        if prof.get("ssl_mode"):
            args += ["--ssl-mode=%s" % prof["ssl_mode"]] if "mariadb" not in os.path.basename(binary) \
                else (["--ssl"] if prof["ssl_mode"].upper() != "DISABLED" else [])
        if readonly:
            args += ["--init-command=SET SESSION TRANSACTION READ ONLY"]
        try:
            r = subprocess.run(args, input=fill_placeholders(sql), capture_output=True, text=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            raise Fail("timeout after %ss" % timeout)
        if r.returncode:
            raise Fail(redact(r.stderr.strip() or "client exited %d" % r.returncode, [pw] if pw else []))
        return redact(r.stdout, [pw] if pw else [])
    finally:
        if cnf and os.path.exists(cnf):
            os.unlink(cnf)


def rows(out):
    lines = out.split("\n")
    if lines and lines[-1] == "":
        lines.pop()  # only the trailing newline; an empty line inside is a real empty value
    if not lines:
        return []
    head = lines[0].split("\t")
    return [dict(zip(head, l.split("\t"))) for l in lines[1:]]


def q(prof, sql):
    return rows(run_sql(prof, sql))


# ---- statement checks -----------------------------------------------------------------------

def split_statements(sql):
    """Splits on ; outside quotes and strips comments. Plain scanner, no client-side parsing."""
    out, cur, quote, i = [], [], None, 0
    while i < len(sql):
        c = sql[i]
        if quote:
            cur.append(c)
            if c == "\\" and quote != "`" and i + 1 < len(sql):
                cur.append(sql[i + 1])
                i += 1
            elif c == quote:
                quote = None
        elif c in "'\"`":
            quote = c
            cur.append(c)
        elif sql.startswith("/*", i):
            j = sql.find("*/", i + 2)
            if j < 0:
                raise Fail("unterminated comment")
            i = j + 1
            cur.append(" ")
        elif sql.startswith("-- ", i) or c == "#":
            j = sql.find("\n", i)
            i = len(sql) if j < 0 else j
        elif c == ";":
            out.append("".join(cur).strip())
            cur = []
        else:
            cur.append(c)
        i += 1
    if quote:
        raise Fail("unterminated quote")
    out.append("".join(cur).strip())
    return [s for s in out if s]


RO_FIRST = re.compile(r"^(select|show|describe|desc)\b|^explain\s+(analyze\s+|format\s*=\s*\w+\s+|extended\s+)*select\b", re.I)
RO_BAD = re.compile(r"\binto\s+(outfile|dumpfile)\b|\bfor\s+update\b|\block\s+in\s+share\b|\b(get_lock|release_lock|sleep|"
                    r"benchmark|load_file)\s*\(|\binto\s+@", re.I)


def check_readonly(sql):
    stmts = split_statements(sql)
    if len(stmts) != 1:
        raise Fail("query takes exactly one statement")
    s = stmts[0]
    if re.match(r"^with\b", s, re.I) and not re.search(r"\b(insert|update|delete|replace|create|drop|alter)\b", s, re.I):
        pass
    elif not RO_FIRST.match(s):
        raise Fail("query is read-only: SELECT, SHOW, DESCRIBE or EXPLAIN SELECT only")
    if RO_BAD.search(s):
        raise Fail("this statement is not allowed in a read-only query")
    return s


WRITE_OK = [re.compile(p, re.I) for p in (
    r"^create\s+user\s+(if\s+not\s+exists\s+)?'?[\w.-]+'?@'[^']*'\s+identified\s+(with\s+\w+\s+)?by\s+'@@ENV:[A-Z0-9_]+@@'",
    r"^grant\s+(replication\s+(slave|replica)|backup_admin|clone_admin|replica\s+monitor)\b[\w\s,]*\s+on\s+\*\.\*\s+to\s+",
    r"^change\s+(replication\s+source|master)\s+to\b",
    r"^(start|stop)\s+(replica|slave)\s*$",
    r"^reset\s+(replica|slave)\s*$",
    r"^set\s+global\s+(gtid_purged|gtid_slave_pos|read_only|super_read_only|clone_valid_donor_list|gtid_strict_mode)\s*=",
    r"^install\s+plugin\s+clone\s+soname\s+'mysql_clone\.so'\s*$",
    r"^clone\s+instance\s+from\b",
)]
NEVER = re.compile(r"\b(drop|truncate|delete|update|insert|alter|rename|purge)\b|reset\s+(binary|master|replica\s+all|slave\s+all)", re.I)


def check_write(sql):
    stmts = split_statements(sql)
    if not stmts:
        raise Fail("empty statement")
    for s in stmts:
        head = re.sub(r"'(?:[^'\\]|\\.|'')*'", "''", s)  # ignore text inside literals
        if NEVER.search(head):
            raise Fail("destructive statement refused; the user runs it by hand: %.60s" % s)
        if not any(rx.match(s) for rx in WRITE_OK):
            raise Fail("statement not in the replication-setup allowlist: %.60s" % s)
        if re.search(r"(source|master)_password\s*=\s*'(?!@@ENV:)|identified\s+(with\s+\w+\s+)?by\s+'(?!@@ENV:)", s, re.I):
            raise Fail("literal password refused; use '@@ENV:NAME@@'")
    return stmts


# ---- facts about a server -------------------------------------------------------------------

def parse_version(v):
    m = re.match(r"(\d+)\.(\d+)\.(\d+)", v)
    return tuple(int(x) for x in m.groups()) if m else (0, 0, 0)


def flavor_of(version, comment):
    if "mariadb" in version.lower() or "mariadb" in comment.lower():
        return "mariadb"
    return "percona" if "percona" in comment.lower() else "mysql"


def supported(flavor, ver):
    return ver[:2] >= (MIN_MARIADB if flavor == "mariadb" else MIN_MYSQL)


VARS = ("server_id", "log_bin", "binlog_format", "gtid_mode", "enforce_gtid_consistency", "gtid_strict_mode",
        "read_only", "super_read_only", "datadir", "innodb_buffer_pool_size", "max_connections", "sql_mode",
        "character_set_server", "innodb_flush_log_at_trx_commit", "sync_binlog", "log_replica_updates",
        "log_slave_updates", "binlog_expire_logs_seconds", "innodb_page_size", "version_compile_os")


def variables(prof):
    names = ",".join("'%s'" % n for n in VARS)
    return {r["Variable_name"]: r["Value"] for r in q(prof, "SHOW GLOBAL VARIABLES WHERE Variable_name IN (%s)" % names)}


def facts(prof):
    r = q(prof, "SELECT VERSION() AS v, @@version_comment AS c")[0]
    ver = parse_version(r["v"])
    fl = flavor_of(r["v"], r["c"])
    f = {"version": r["v"], "comment": r["c"], "flavor": fl, "ver": ver, "supported": supported(fl, ver), "vars": variables(prof)}
    sz = q(prof, "SELECT COALESCE(SUM(data_length+index_length),0) AS b FROM information_schema.tables "
                 "WHERE table_schema NOT IN ('mysql','sys','information_schema','performance_schema')")
    f["data_bytes"] = int(sz[0]["b"]) if sz else 0
    return f


def human(n):
    n = float(n)
    for u in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or u == "TiB":
            return "%.1f %s" % (n, u)
        n /= 1024


# ---- replica status -------------------------------------------------------------------------

def pick(d, *names):
    for n in names:
        if n in d:
            return d[n]
    return None


def replica_status(prof, max_lag=30):
    out = run_sql(prof, "SHOW REPLICA STATUS")
    rs = rows(out)
    if not rs:
        return {"role": "not a replica", "verdict": "NONE", "problems": []}
    d = rs[0]
    io = pick(d, "Replica_IO_Running", "Slave_IO_Running")
    sq = pick(d, "Replica_SQL_Running", "Slave_SQL_Running")
    lag = pick(d, "Seconds_Behind_Source", "Seconds_Behind_Master")
    err = " | ".join(e for e in (pick(d, "Last_IO_Error"), pick(d, "Last_SQL_Error"), pick(d, "Last_Error")) if e)
    res = {"source": pick(d, "Source_Host", "Master_Host"), "io": io, "sql": sq, "lag": lag, "errors": err,
           "gtid": pick(d, "Auto_Position") or pick(d, "Using_Gtid"),
           "retrieved": pick(d, "Retrieved_Gtid_Set"), "executed": pick(d, "Executed_Gtid_Set"),
           "sql_state": pick(d, "Replica_SQL_Running_State", "Slave_SQL_Running_State")}
    problems = []
    if io != "Yes":
        problems.append("IO thread is %s" % io)
    if sq != "Yes":
        problems.append("SQL thread is %s" % sq)
    if err:
        problems.append("error: %s" % err)
    if lag in (None, "NULL"):
        problems.append("lag unknown (NULL)")
    elif int(lag) > max_lag:
        problems.append("lag %ss is over %ss" % (lag, max_lag))
    if res["gtid"] in (None, "0", "No"):
        problems.append("GTID auto-positioning is off")
    res["problems"] = problems
    res["verdict"] = "OK" if not problems else ("BROKEN" if io != "Yes" or sq != "Yes" or err else "LAGGING")
    return res


# ---- inspect --------------------------------------------------------------------------------

def inspect(prof):
    f = facts(prof)
    md = ["# %s %s" % (f["flavor"], f["version"]), "",
          "Supported baseline: %s" % ("yes" if f["supported"] else "NO (needs MySQL/Percona 8.4+ or MariaDB 10.11+)"), "",
          "## Settings", ""] + ["- %s = %s" % kv for kv in sorted(f["vars"].items())]
    st = {r["Variable_name"]: r["Value"] for r in q(prof, "SHOW GLOBAL STATUS WHERE Variable_name IN "
         "('Uptime','Threads_connected','Max_used_connections','Aborted_connects','Slow_queries','Innodb_buffer_pool_reads',"
         "'Innodb_buffer_pool_read_requests')")}
    md += ["", "## Load", ""] + ["- %s = %s" % kv for kv in sorted(st.items())]
    md += ["", "## Schemas by size", ""]
    for r in q(prof, "SELECT table_schema AS db, COUNT(*) AS tables, SUM(data_length+index_length) AS bytes FROM information_schema.tables "
                     "WHERE table_schema NOT IN ('mysql','sys','information_schema','performance_schema') GROUP BY table_schema ORDER BY bytes DESC LIMIT 30"):
        md.append("- %s: %s tables, %s" % (r["db"], r["tables"], human(r["bytes"] or 0)))
    md += ["", "## Largest tables", ""]
    for r in q(prof, "SELECT table_schema AS db, table_name AS t, engine AS e, table_rows AS r, data_length+index_length AS bytes FROM information_schema.tables "
                     "WHERE table_schema NOT IN ('mysql','sys','information_schema','performance_schema') ORDER BY bytes DESC LIMIT 15"):
        md.append("- %s.%s (%s, ~%s rows): %s" % (r["db"], r["t"], r["e"], r["r"], human(r["bytes"] or 0)))
    md += ["", "## Findings", ""]
    finds = []
    for r in q(prof, "SELECT t.table_schema AS db, t.table_name AS t FROM information_schema.tables t LEFT JOIN information_schema.table_constraints c "
                     "ON c.table_schema=t.table_schema AND c.table_name=t.table_name AND c.constraint_type='PRIMARY KEY' "
                     "WHERE t.table_type='BASE TABLE' AND c.constraint_name IS NULL AND t.table_schema NOT IN ('mysql','sys','information_schema','performance_schema') LIMIT 20"):
        finds.append("table without primary key (breaks row-based replication speed): %s.%s" % (r["db"], r["t"]))
    for r in q(prof, "SELECT table_schema AS db, table_name AS t, engine AS e FROM information_schema.tables WHERE engine IS NOT NULL AND engine NOT IN ('InnoDB','PERFORMANCE_SCHEMA','CSV') "
                     "AND table_schema NOT IN ('mysql','sys','information_schema','performance_schema') LIMIT 20"):
        finds.append("non-InnoDB table (%s): %s.%s" % (r["e"], r["db"], r["t"]))
    for r in q(prof, "SELECT user AS u, host AS h FROM mysql.user WHERE user='' OR host='%'"):
        finds.append("account open to any host or anonymous: '%s'@'%s'" % (r["u"], r["h"]))
    v = f["vars"]
    if v.get("log_bin") in ("OFF", "0"):
        finds.append("binary log is off: it cannot be a replication source")
    if f["flavor"] != "mariadb" and v.get("gtid_mode") != "ON":
        finds.append("gtid_mode is %s: replicas need GTID" % v.get("gtid_mode"))
    if v.get("binlog_format") not in (None, "ROW"):
        finds.append("binlog_format is %s (ROW is the safe choice)" % v.get("binlog_format"))
    if v.get("sync_binlog") not in (None, "1") or v.get("innodb_flush_log_at_trx_commit") not in (None, "1"):
        finds.append("durability relaxed (sync_binlog=%s, innodb_flush_log_at_trx_commit=%s)" % (v.get("sync_binlog"), v.get("innodb_flush_log_at_trx_commit")))
    md += ["- " + x for x in finds] or ["- none"]
    rs = replica_status(prof)
    md += ["", "## Replication", "", "- %s %s" % (rs["verdict"], "; ".join(rs.get("problems", [])))]
    return "\n".join(md) + "\n"


# ---- replica planner ------------------------------------------------------------------------

METHODS = {"mysql": ("xtrabackup", "clone", "dump"), "percona": ("xtrabackup", "clone", "dump"), "mariadb": ("mariabackup", "dump")}


def blockers_for(src, rep, method):
    b = []
    for who, f in (("source", src), ("replica", rep)):
        if not f["supported"]:
            b.append("%s %s %s is below the supported baseline" % (who, f["flavor"], f["version"]))
    if (src["flavor"] == "mariadb") != (rep["flavor"] == "mariadb"):
        b.append("MySQL/Percona and MariaDB cannot replicate physically from each other; use the same family")
    if method not in METHODS[src["flavor"]]:
        b.append("method %s is not available for %s (use %s)" % (method, src["flavor"], "/".join(METHODS[src["flavor"]])))
    if rep["ver"][:2] < src["ver"][:2]:
        b.append("replica %s is older than source %s" % (rep["version"], src["version"]))
    if method in ("clone", "xtrabackup", "mariabackup") and rep["ver"][:2] != src["ver"][:2]:
        b.append("physical copy and CLONE need the same release series on both sides")
    if method == "clone" and src["flavor"] != rep["flavor"]:
        b.append("CLONE needs the same flavor on both sides")
    sv, rv = src["vars"], rep["vars"]
    if sv.get("log_bin") in ("OFF", "0"):
        b.append("source has the binary log off")
    if src["flavor"] != "mariadb" and sv.get("gtid_mode") != "ON":
        b.append("source gtid_mode is %s; it must be ON (enable it in steps, online)" % sv.get("gtid_mode"))
    if sv.get("server_id") == rv.get("server_id"):
        b.append("server_id is %s on both; the replica needs its own" % sv.get("server_id"))
    return b


def runbook(src, rep, method, sp, rp):
    mdb = src["flavor"] == "mariadb"
    size = human(src["data_bytes"])
    A = "[CONFIRM]"
    steps = ["Source %s %s, replica %s %s. Data to copy: about %s (plus logs). Free at least twice that on the backup and replica disks." % (
        src["flavor"], src["version"], rep["flavor"], rep["version"], size),
        "Replication user on the source (your secret REPL_PW first: ! mysql-tool secret-gen REPL_PW):\n"
        "   mysql-tool exec %s \"CREATE USER 'repl'@'<replica_ip>' IDENTIFIED BY '@@ENV:REPL_PW@@'\"\n"
        "   mysql-tool exec %s \"GRANT REPLICATION SLAVE ON *.* TO 'repl'@'<replica_ip>'\"  %s" % (sp, sp, A)]
    cli = "mariadb-backup" if mdb else "xtrabackup"
    if method in ("xtrabackup", "mariabackup"):
        steps += [
            "[source host] backup (credentials in an option file with mode 600, never on the command line):\n"
            "   %s --defaults-extra-file=<backup.cnf> --backup --target-dir=<backup_dir>   (and %s)" % (cli, "--slave-info --safe-slave-backup if the source is itself a replica"),
            "[source host] prepare:  %s --prepare --target-dir=<backup_dir>" % cli,
            "transfer to the replica host:  rsync -avP <backup_dir>/ <replica_host>:<backup_dir>/  %s" % A,
            "[replica host] stop the server  %s ; move the old datadir aside  %s :\n"
            "   systemctl stop <service> ; mv <datadir> <datadir>.old-<date>" % (A, A),
            "[replica host] restore  %s :  %s --%s --target-dir=<backup_dir> ; chown -R mysql:mysql <datadir>" % (
                A, cli, "copy-back" if mdb else "move-back"),
            "[replica host] my.cnf: unique server_id (not %s), log_bin, %s, read_only=ON%s, skip_replica_start=ON ; start the server  %s" % (
                src["vars"].get("server_id"), "gtid_strict_mode=ON" if mdb else "gtid_mode=ON + enforce_gtid_consistency=ON",
                "" if mdb else ", super_read_only=ON", A),
        ]
        if mdb:
            steps += ["[replica host] read the GTID from <datadir>/xtrabackup_binlog_info (third field), then:\n"
                      "   mysql-tool exec %s \"SET GLOBAL gtid_slave_pos='<gtid>'\"  %s" % (rp, A)]
        else:
            steps += ["[replica] compare: mysql-tool query %s \"SELECT @@GLOBAL.gtid_executed\" with the GTID set in xtrabackup_binlog_info.\n"
                      "   Equal: continue. Empty: mysql-tool exec %s \"SET GLOBAL gtid_purged='<set>'\"  %s\n"
                      "   Anything else: STOP. RESET BINARY LOGS AND GTIDS is not run by this tool; the user decides." % (rp, rp, A)]
    elif method == "clone":
        steps += [
            "Both servers: mysql-tool exec <profile> \"INSTALL PLUGIN clone SONAME 'mysql_clone.so'\"  %s (check SHOW PLUGINS first)" % A,
            "Clone accounts: BACKUP_ADMIN on the donor, CLONE_ADMIN on the recipient, in the same way as step 2. Use a secret CLONE_PW.",
            "Recipient: mysql-tool exec %s \"SET GLOBAL clone_valid_donor_list='<source_host>:3306'\"  %s" % (rp, A),
            "Recipient: this ERASES the recipient's data and restarts it under a supervisor (systemd)  %s :\n"
            "   mysql-tool exec %s \"CLONE INSTANCE FROM 'clone_user'@'<source_host>':3306 IDENTIFIED BY '@@ENV:CLONE_PW@@' REQUIRE SSL\"" % (A, rp),
            "Wait for the restart; check performance_schema.clone_status (STATE = 'Completed'). The recipient's accounts are now the donor's.",
        ]
    else:
        d = ("mariadb-dump --single-transaction --master-data=2 --gtid --routines --events --triggers --all-databases"
             if mdb else "mysqldump --single-transaction --source-data=2 --set-gtid-purged=ON --routines --events --triggers --all-databases")
        steps += ["[source host] dump (small and medium data only; it is slow to restore):\n   %s --defaults-extra-file=<dump.cnf> > <dump_file>" % d,
                  "transfer the file, then restore on the replica  %s :  mysql --defaults-extra-file=<replica.cnf> < <dump_file>" % A]
        if mdb:
            steps += ["read the CHANGE MASTER line or gtid in the dump header; mysql-tool exec %s \"SET GLOBAL gtid_slave_pos='<gtid>'\"  %s" % (rp, A)]
    if mdb:
        steps += ["[replica] point it at the source:\n   mysql-tool exec %s \"CHANGE MASTER TO MASTER_HOST='<source_host>', MASTER_PORT=3306, MASTER_USER='repl', "
                  "MASTER_PASSWORD='@@ENV:REPL_PW@@', MASTER_USE_GTID=slave_pos, MASTER_SSL=1\"  %s\n   mysql-tool exec %s \"START REPLICA\"  %s" % (rp, A, rp, A)]
    else:
        steps += ["[replica] point it at the source:\n   mysql-tool exec %s \"CHANGE REPLICATION SOURCE TO SOURCE_HOST='<source_host>', SOURCE_PORT=3306, SOURCE_USER='repl', "
                  "SOURCE_PASSWORD='@@ENV:REPL_PW@@', SOURCE_AUTO_POSITION=1, SOURCE_SSL=1\"  %s\n   mysql-tool exec %s \"START REPLICA\"  %s" % (rp, A, rp, A)]
    steps += ["Verify until lag is 0:  mysql-tool replica-status %s" % rp,
              "Only then remove read_only if it should take writes (usually it must not), and keep the backup until the replica has run a day."]
    return "\n".join("%d. %s" % (i, s) for i, s in enumerate(steps, 1))


def plan(sp, rp, method):
    src, rep = facts(get_profile(sp)), facts(get_profile(rp))
    b = blockers_for(src, rep, method)
    out = ["# Replica plan: %s -> %s by %s" % (sp, rp, method), ""]
    if b:
        out += ["## Blockers (fix these first, no runbook until then)", ""] + ["- " + x for x in b]
    else:
        out += ["Preflight passed. Steps marked [CONFIRM] need the user's yes before they run.", "", runbook(src, rep, method, sp, rp)]
    return "\n".join(out) + "\n", not b


# ---- more facts -----------------------------------------------------------------------------

def all_vars(prof):
    return {r["Variable_name"]: r["Value"] for r in q(prof, "SHOW GLOBAL VARIABLES")}


def clean_gtid(s):
    s = (s or "").replace("\\n", "").replace("\n", "").replace(" ", "").strip()
    if not re.fullmatch(r"[0-9a-fA-F:,\-]*", s):
        raise Fail("unexpected characters in a GTID set")
    return s


def gtid_executed(prof, flavor):
    col = "@@GLOBAL.gtid_current_pos" if flavor == "mariadb" else "@@GLOBAL.gtid_executed"
    return clean_gtid(q(prof, "SELECT %s AS g" % col)[0]["g"])


# ---- config audit ---------------------------------------------------------------------------

def audit_config(flavor, v):
    """Findings as (level, text) from the global variables. Pure, so it can be tested."""
    out = []
    add = lambda lvl, t: out.append((lvl, t))
    if v.get("sync_binlog") not in (None, "1"):
        add("warn", "sync_binlog=%s: a crash can lose committed transactions from the binary log" % v["sync_binlog"])
    if v.get("innodb_flush_log_at_trx_commit") not in (None, "1"):
        add("warn", "innodb_flush_log_at_trx_commit=%s: a crash can lose committed transactions" % v["innodb_flush_log_at_trx_commit"])
    if v.get("log_bin") in ("OFF", "0"):
        add("warn", "binary log is off: no replication source, no point-in-time recovery")
    if v.get("binlog_format") not in (None, "ROW"):
        add("info", "binlog_format=%s; ROW is the safe choice for replication" % v["binlog_format"])
    if flavor != "mariadb":
        if v.get("gtid_mode") != "ON":
            add("warn", "gtid_mode=%s: replicas and failover need GTID" % v.get("gtid_mode"))
        if v.get("enforce_gtid_consistency") != "ON":
            add("warn", "enforce_gtid_consistency=%s" % v.get("enforce_gtid_consistency"))
        if v.get("require_secure_transport") == "OFF":
            add("info", "require_secure_transport=OFF: clients may connect without TLS")
    elif v.get("gtid_strict_mode") == "OFF":
        add("info", "gtid_strict_mode=OFF: out-of-order GTIDs are accepted silently")
    sm = v.get("sql_mode", "")
    if sm and "STRICT_TRANS_TABLES" not in sm and "STRICT_ALL_TABLES" not in sm:
        add("warn", "sql_mode has no strict mode: bad data is truncated silently")
    if v.get("character_set_server") not in (None, "utf8mb4"):
        add("info", "character_set_server=%s (utf8mb4 is the usual choice)" % v["character_set_server"])
    if v.get("local_infile") == "ON":
        add("warn", "local_infile=ON: a hostile server or query can read client files")
    if v.get("skip_name_resolve") == "OFF":
        add("info", "skip_name_resolve=OFF: DNS lookups on every connection, host-based accounts depend on DNS")
    for k in ("binlog_expire_logs_seconds", "expire_logs_days"):
        if v.get(k) == "0" and v.get("log_bin") not in ("OFF", "0"):
            if k == "binlog_expire_logs_seconds" and v.get("expire_logs_days", "0") != "0":
                continue
            add("warn", "%s=0: binary logs are never purged and will fill the disk" % k)
    if v.get("innodb_buffer_pool_size") == "134217728":
        add("info", "innodb_buffer_pool_size is the 128 MiB default; size it for the working set")
    if v.get("performance_schema") == "OFF":
        add("info", "performance_schema=OFF: no query digests for /dynamia-mysql:performance")
    if v.get("max_connections", "").isdigit() and int(v["max_connections"]) > 2000:
        add("info", "max_connections=%s is very high; each connection costs memory" % v["max_connections"])
    return out


ACCOUNT_COLS = ("plugin", "ssl_type", "Super_priv", "Grant_priv", "File_priv", "Shutdown_priv", "account_locked", "password_expired")


def account_rows(prof):
    have = {r["column_name"].lower(): r["column_name"] for r in q(
        prof, "SELECT column_name FROM information_schema.columns WHERE table_schema='mysql' AND table_name='user'")}
    cols = [have[c.lower()] for c in ACCOUNT_COLS if c.lower() in have]
    sel = ", ".join(["User", "Host"] + cols)  # never the password or hash columns
    return q(prof, "SELECT %s FROM mysql.user" % sel)


def audit_accounts(rs):
    out = []
    for r in rs:
        who = "'%s'@'%s'" % (r.get("User", ""), r.get("Host", ""))
        if r.get("User", "") == "":
            out.append(("warn", "anonymous account %s" % who))
        if r.get("Host") == "%" and r.get("User") != "":
            out.append(("warn", "%s accepts connections from any host" % who))
        if r.get("Host") not in ("localhost", "127.0.0.1", "::1") and r.get("ssl_type", "ANY") in ("", None):
            out.append(("info", "%s is reachable from the network and does not require TLS" % who))
        for p in ("Super_priv", "Grant_priv", "File_priv", "Shutdown_priv"):
            if r.get(p) == "Y" and r.get("User") not in ("root", "mariadb.sys", "mysql.sys", "rdsadmin"):
                out.append(("warn", "%s has %s" % (who, p.replace("_priv", "").upper())))
        if r.get("plugin") == "mysql_native_password":
            out.append(("info", "%s uses mysql_native_password (off by default since MySQL 8.4)" % who))
        if r.get("account_locked") == "N" and r.get("password_expired") == "Y":
            out.append(("info", "%s has an expired password" % who))
    return out


SECRET_PATTERNS = [
    ("password in a config line", re.compile(r"(?i)^\s*(password|pwd)\s*=\s*(?!@@ENV:)\S+")),
    ("password on a command line", re.compile(r"(?i)\b(mysql\w*|mariadb\w*|xtrabackup|mariabackup)\b.*\s(-p\S+|--password=\S+)")),
    ("MYSQL_PWD value", re.compile(r"MYSQL_PWD=\S+")),
    ("literal password in SQL", re.compile(r"(?i)(identified\s+(with\s+\w+\s+)?by|(source|master)_password\s*=)\s*'(?!@@ENV:)[^']+'")),
]


def scan_file(path):
    hits = []
    try:
        if os.path.getsize(path) > 5_000_000:
            return hits
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError:
        return hits
    if b"\0" in data:
        return hits
    for n, line in enumerate(data.decode("utf-8", "replace").splitlines(), 1):
        for kind, rx in SECRET_PATTERNS:
            if rx.search(line):
                hits.append((path, n, kind))
    return hits


def scan_secrets(paths):
    home = os.path.expanduser("~")
    if not paths:
        paths = [os.path.join(home, f) for f in (".my.cnf", ".bash_history", ".zsh_history", ".mysql_history")]
        paths.append(os.path.join(HOME(), "profiles.toml"))
    hits, notes = [], []
    for p in paths:
        if os.path.isdir(p):
            for base, dirs, files in os.walk(p):
                dirs[:] = [d for d in dirs if d not in {".git", "node_modules", "__pycache__", ".venv"}]
                for f in files:
                    hits += scan_file(os.path.join(base, f))
        elif os.path.isfile(p):
            hits += scan_file(p)
            if os.path.basename(p) == ".my.cnf" and os.stat(p).st_mode & 0o077:
                notes.append("%s is readable by others (chmod 600)" % p)
    for p in (secrets_path(), os.path.join(os.path.expanduser("~"), ".mylogin.cnf")):
        if os.path.exists(p) and os.stat(p).st_mode & 0o077:
            notes.append("%s is readable by others (chmod 600)" % p)
    return hits, notes


# ---- performance ----------------------------------------------------------------------------

def slow_queries(prof, limit=10):
    if q(prof, "SELECT @@performance_schema AS p")[0]["p"] not in ("1", "ON"):
        raise Fail("performance_schema is off on this server; enable it in the config (restart needed) or read the slow query log")
    rs = q(prof, "SELECT COALESCE(SCHEMA_NAME,'-') AS db, LEFT(DIGEST_TEXT,200) AS query, COUNT_STAR AS calls, "
                 "ROUND(SUM_TIMER_WAIT/1e12,2) AS total_s, ROUND(AVG_TIMER_WAIT/1e12,4) AS avg_s, "
                 "SUM_ROWS_EXAMINED AS examined, SUM_ROWS_SENT AS sent, SUM_NO_INDEX_USED AS no_index "
                 "FROM performance_schema.events_statements_summary_by_digest "
                 "WHERE DIGEST_TEXT IS NOT NULL AND COALESCE(SCHEMA_NAME,'') NOT IN ('mysql','sys','performance_schema','information_schema') "
                 "ORDER BY SUM_TIMER_WAIT DESC LIMIT %d" % int(limit))
    for r in rs:
        flags = []
        if int(r["no_index"] or 0) > 0:
            flags.append("runs without a usable index")
        if int(r["sent"] or 0) and int(r["examined"] or 0) / int(r["sent"]) > 100:
            flags.append("reads %dx more rows than it returns" % (int(r["examined"]) / int(r["sent"])))
        r["flags"] = "; ".join(flags)
    return rs


def locks(prof, flavor):
    out = {"transactions": q(prof, "SELECT trx_id, trx_state, trx_started, TIMESTAMPDIFF(SECOND,trx_started,NOW()) AS age_s, "
                                   "trx_mysql_thread_id AS thread, trx_rows_modified AS rows_mod, LEFT(COALESCE(trx_query,''),120) AS query "
                                   "FROM information_schema.innodb_trx ORDER BY trx_started LIMIT 20")}
    if flavor == "mariadb":
        out["waits"] = q(prof, "SELECT r.trx_mysql_thread_id AS waiting_pid, b.trx_mysql_thread_id AS blocking_pid, "
                               "TIMESTAMPDIFF(SECOND,r.trx_wait_started,NOW()) AS wait_s FROM information_schema.innodb_lock_waits w "
                               "JOIN information_schema.innodb_trx r ON r.trx_id=w.requesting_trx_id "
                               "JOIN information_schema.innodb_trx b ON b.trx_id=w.blocking_trx_id LIMIT 20")
    else:
        out["waits"] = q(prof, "SELECT waiting_pid, blocking_pid, wait_age_secs AS wait_s, locked_table, LEFT(waiting_query,100) AS waiting_query, "
                               "LEFT(blocking_query,100) AS blocking_query FROM sys.innodb_lock_waits LIMIT 20")
    st = run_sql(prof, "SHOW ENGINE INNODB STATUS").replace("\\n", "\n")
    m = re.search(r"LATEST DETECTED DEADLOCK\n-+\n(.*?)\n-{8,}\n[A-Z ]+\n-{8,}", st, re.S)
    out["deadlock"] = m.group(1).strip()[:3000] if m else ""
    return out


# ---- schema diff ----------------------------------------------------------------------------

SYS = "('mysql','sys','information_schema','performance_schema')"


def schema_snapshot(prof, schema=None):
    where = "table_schema NOT IN %s" % SYS + (" AND table_schema='%s'" % sql_literal(schema) if schema else "")
    snap = {"tables": {}, "columns": {}, "indexes": {}}
    for r in q(prof, "SELECT table_schema AS s, table_name AS t, engine AS e FROM information_schema.tables WHERE table_type='BASE TABLE' AND %s" % where):
        snap["tables"]["%s.%s" % (r["s"], r["t"])] = r["e"]
    for r in q(prof, "SELECT table_schema AS s, table_name AS t, column_name AS c, column_type AS ty, is_nullable AS n, "
                     "COALESCE(collation_name,'') AS co FROM information_schema.columns WHERE %s" % where):
        snap["columns"]["%s.%s.%s" % (r["s"], r["t"], r["c"])] = "%s null=%s %s" % (r["ty"], r["n"], r["co"])
    for r in q(prof, "SELECT table_schema AS s, table_name AS t, index_name AS i, GROUP_CONCAT(column_name ORDER BY seq_in_index) AS cols, "
                     "MIN(non_unique) AS nu FROM information_schema.statistics WHERE %s GROUP BY table_schema, table_name, index_name" % where):
        snap["indexes"]["%s.%s#%s" % (r["s"], r["t"], r["i"])] = "(%s) %s" % (r["cols"], "unique" if r["nu"] == "0" else "")
    return snap


def schema_diff(a, b, na="A", nb="B"):
    out = []
    for kind, one in (("tables", "table"), ("columns", "column"), ("indexes", "index")):
        ka, kb = a[kind], b[kind]
        out += ["only in %s, %s: %s" % (na, one, k) for k in sorted(set(ka) - set(kb))]
        out += ["only in %s, %s: %s" % (nb, one, k) for k in sorted(set(kb) - set(ka))]
        out += ["differs, %s %s: %s=%s  %s=%s" % (one, k, na, ka[k].strip(), nb, kb[k].strip())
                for k in sorted(set(ka) & set(kb)) if ka[k].strip() != kb[k].strip()]
    return out


# ---- upgrade check --------------------------------------------------------------------------

REMOVED_84 = ("binlog_transaction_dependency_tracking", "default_authentication_plugin", "expire_logs_days", "transaction_write_set_extraction",
              "avoid_temporal_upgrade", "show_old_temporals", "log_bin_use_v1_events", "master_info_repository", "relay_log_info_repository",
              "slave_rows_search_algorithms", "have_ssl", "have_openssl", "group_replication_ip_whitelist", "group_replication_recovery_complete_at")


def upgrade_findings(flavor, ver, explicit, accounts, spatial):
    """explicit: variables set in config or on the command line. Rules are for MySQL/Percona 8.0 to 8.4 only."""
    if flavor == "mariadb":
        return [("info", "No verified rule list for MariaDB in this tool. Read the release notes of every version between %d.%d and the target, "
                         "take a tested backup, upgrade replicas first and run mariadb-upgrade after." % ver[:2])]
    if ver[:2] >= (8, 4):
        return [("info", "Already on %d.%d; nothing to check for 8.0 to 8.4." % ver[:2])]
    if ver[:2] != (8, 0):
        return [("warn", "%d.%d is not an upgrade source for 8.4; the supported path is 8.0 to 8.4 (confirm in the MySQL 'Upgrade Paths' page)" % ver[:2])]
    out = [("warn", "variable %s is set explicitly and was removed in 8.4: the server will not start with it" % n) for n in REMOVED_84 if n in explicit]
    out += [("warn", "%d account(s) use mysql_native_password, which is not enabled by default in 8.4 (re-enable with mysql_native_password=ON or move them to caching_sha2_password)" % accounts)] if accounts else []
    out += [("warn", "%d spatial index(es): for 8.4.4 and later, drop them before the upgrade and recreate them after" % spatial)] if spatial else []
    out += [("info", "defaults changed in 8.4 (review them): innodb_adaptive_hash_index OFF, innodb_change_buffering none, innodb_flush_method O_DIRECT, "
                     "innodb_io_capacity 10000, innodb_log_buffer_size 64MiB; WAIT_UNTIL_SQL_THREAD_AFTER_GTIDS() is removed (use WAIT_FOR_EXECUTED_GTID_SET)"),
            ("info", "also run the MySQL Shell upgrade checker (util.checkForServerUpgrade) and mysqlcheck --check-upgrade, and upgrade replicas before the source")]
    return out


def upgrade_check(prof):
    r = q(prof, "SELECT VERSION() AS v, @@version_comment AS c")[0]
    ver, fl = parse_version(r["v"]), flavor_of(r["v"], r["c"])
    explicit, accounts, spatial = [], 0, 0
    if fl != "mariadb" and ver[:2] == (8, 0):
        names = ",".join("'%s'" % n for n in REMOVED_84)
        explicit = [x["VARIABLE_NAME"].lower() for x in q(prof, "SELECT VARIABLE_NAME FROM performance_schema.variables_info "
                    "WHERE VARIABLE_SOURCE <> 'COMPILED' AND LOWER(VARIABLE_NAME) IN (%s)" % names)]
        accounts = int(q(prof, "SELECT COUNT(*) AS n FROM mysql.user WHERE plugin='mysql_native_password'")[0]["n"])
        spatial = int(q(prof, "SELECT COUNT(*) AS n FROM information_schema.statistics WHERE index_type='SPATIAL'")[0]["n"])
    return fl, r["v"], upgrade_findings(fl, ver, explicit, accounts, spatial)


# ---- monitor --------------------------------------------------------------------------------

def monitor_one(name, max_lag=30, max_conn_pct=85):
    prof = get_profile(name)
    try:
        r = q(prof, "SELECT VERSION() AS v, @@version_comment AS c, @@max_connections AS mc, @@read_only AS ro")[0]
        st = {x["Variable_name"]: x["Value"] for x in q(prof, "SHOW GLOBAL STATUS WHERE Variable_name IN ('Uptime','Threads_connected')")}
        rs = replica_status(prof, max_lag)
    except Fail as e:
        return False, "DOWN %s: %s" % (name, str(e).splitlines()[0][:120])
    problems = []
    pct = int(st.get("Threads_connected", 0)) * 100 // max(1, int(r["mc"]))
    if pct >= max_conn_pct:
        problems.append("connections at %d%%" % pct)
    if rs["verdict"] in ("BROKEN", "LAGGING"):
        problems += rs["problems"]
    line = "%s %s %s %s up=%sd conn=%s/%s ro=%s repl=%s" % ("OK" if not problems else "WARN", name, flavor_of(r["v"], r["c"]), r["v"],
                                                           int(st.get("Uptime", 0)) // 86400, st.get("Threads_connected"), r["mc"], r["ro"], rs["verdict"])
    return not problems, line + ("  <- " + "; ".join(problems) if problems else "")


# ---- diagnose a broken replica --------------------------------------------------------------

def diagnose(rep, src):
    r = replica_status(rep)
    if r["verdict"] in ("OK", "NONE"):
        return r["verdict"], ["Nothing to repair: %s." % ("not a replica" if r["verdict"] == "NONE" else "replication is healthy")]
    if r["verdict"] == "LAGGING":
        return "LAGGING", ["Replication runs but is behind: %s" % "; ".join(r["problems"]),
                           "Look for long transactions on the source, tables without primary key (/dynamia-mysql:inspect), a slow replica disk, and /dynamia-mysql:performance on the replica."]
    st = rows(run_sql(rep, "SHOW REPLICA STATUS"))[0]
    io_no, sql_no = int(st.get("Last_IO_Errno") or 0), int(st.get("Last_SQL_Errno") or st.get("Last_Errno") or 0)
    text = r["errors"].lower()
    if io_no == 1236 or "purged" in text:
        return "REBUILD", ["The source no longer has the binary logs this replica needs (error 1236 or purged logs).",
                           "Rebuild it with /dynamia-mysql:replica-setup. Skipping or editing positions would lose or duplicate data."]
    if io_no in (1045, 1130, 2002, 2003, 2013, 2026) or (r["io"] != "Yes" and not sql_no):
        return "CONNECTION", ["The IO thread cannot reach or log in to the source (error %s): %s" % (io_no, r["errors"] or "no message"),
                              "Check network, firewall, the replication account and its host, TLS, and caching_sha2_password needing SSL or the public key.",
                              "Nothing to skip here; fix the cause and START REPLICA (the user confirms)."]
    vc = q(rep, "SELECT VERSION() AS v, @@version_comment AS c")[0]
    fl = flavor_of(vc["v"], vc["c"])
    steps = ["The SQL thread stopped on error %s: %s" % (sql_no, r["errors"] or "no message")]
    if fl != "mariadb":
        errant = clean_gtid(q(rep, "SELECT GTID_SUBTRACT('%s','%s') AS e" % (gtid_executed(rep, fl), gtid_executed(src, fl)))[0]["e"])
        if errant:
            return "ERRANT", steps + ["The replica has transactions the source never had (errant GTIDs): %s" % errant,
                                      "Someone wrote on the replica. Find out who (keep read_only and super_read_only ON). Safest fix is a rebuild with /dynamia-mysql:replica-setup. "
                                      "Injecting empty transactions hides the divergence; only the user may decide that."]
    return "DIVERGED", steps + ["No errant GTIDs found, so the data differs without a GTID trace (a row changed or missing).",
                                "Do not skip the transaction. Compare the table with the source, repair that table by hand, or rebuild the replica."]


# ---- failover plan --------------------------------------------------------------------------

def failover_blockers(cand, status, old_gtid, cand_gtid, missing, old_alive, flavor):
    b = []
    if status["verdict"] == "NONE":
        b.append("the candidate is not a replica")
    elif status["verdict"] == "BROKEN":
        b.append("the candidate's replication is broken: " + "; ".join(status["problems"]))
    if cand["vars"].get("log_bin") in ("OFF", "0"):
        b.append("the candidate has the binary log off")
    if cand["vars"].get("log_replica_updates", cand["vars"].get("log_slave_updates")) in ("OFF", "0"):
        b.append("the candidate does not log replicated updates (log_replica_updates), so other replicas cannot follow it")
    if old_alive:
        if flavor == "mariadb":
            if old_gtid != cand_gtid:
                b.append("candidate position %s differs from the source %s" % (cand_gtid, old_gtid))
        elif missing:
            b.append("the candidate lacks these transactions of the source: %s" % missing)
    return b


def failover_runbook(flavor, old_alive, cand, others):
    mdb = flavor == "mariadb"
    chg = ("CHANGE MASTER TO MASTER_HOST='<new_host>', MASTER_USE_GTID=slave_pos" if mdb
           else "CHANGE REPLICATION SOURCE TO SOURCE_HOST='<new_host>', SOURCE_AUTO_POSITION=1")
    s = []
    if old_alive:
        s.append("[old source] stop writes: mysql-tool exec <old> \"SET GLOBAL read_only=ON\" then %s  [CONFIRM]\n   Tell the applications first; kill nothing without the user." %
                 ("nothing more" if mdb else "mysql-tool exec <old> \"SET GLOBAL super_read_only=ON\""))
        s.append("[candidate] wait until it has everything:\n   %s" % (
            "compare gtid_current_pos on both until equal" if mdb else
            "mysql-tool query %s \"SELECT WAIT_FOR_EXECUTED_GTID_SET('<old gtid_executed>', 30)\"   (0 = caught up)" % cand))
    else:
        s.append("The old source is DOWN. Anything it committed and had not sent is lost. Do not continue unless the user accepts that, in words.")
    s += ["[candidate] mysql-tool exec %s \"STOP REPLICA\"  [CONFIRM]" % cand,
          "[candidate] the user runs by hand (destructive, this tool refuses it): RESET REPLICA ALL",
          "[candidate] open for writes: mysql-tool exec %s \"SET GLOBAL read_only=OFF\"  [CONFIRM]%s" % (cand, "" if mdb else "   (and super_read_only=OFF)")]
    for o in others:
        s.append("[%s] mysql-tool exec %s \"STOP REPLICA\" ; \"%s\" ; \"START REPLICA\"  [CONFIRM each]" % (o, o, chg))
    if old_alive:
        s.append("[old source] make it a replica of the candidate and keep it read_only: same CHANGE statement with SOURCE_USER and SOURCE_PASSWORD='@@ENV:REPL_PW@@'  [CONFIRM]")
    s += ["The user repoints the applications (DNS, proxy, connection strings).",
          "Verify every replica: mysql-tool replica-status <profile>. Keep the old source untouched until it is understood."]
    return "\n".join("%d. %s" % (i, x) for i, x in enumerate(s, 1))


def plan_failover(cand_name, old_name, other_names):
    cand_p = get_profile(cand_name)
    cand = facts(cand_p)
    status = replica_status(cand_p)
    fl = cand["flavor"]
    old_alive, old_gtid, missing = False, "", ""
    if old_name:
        try:
            old_p = get_profile(old_name)
            old_gtid = gtid_executed(old_p, fl)
            old_alive = True
        except Fail:
            pass
    cand_gtid = gtid_executed(cand_p, fl)
    if old_alive and fl != "mariadb":
        missing = clean_gtid(q(cand_p, "SELECT GTID_SUBTRACT('%s','%s') AS m" % (old_gtid, cand_gtid))[0]["m"])
    b = failover_blockers(cand, status, old_gtid, cand_gtid, missing, old_alive, fl)
    out = ["# %s: %s promotes (%s)" % ("Switchover" if old_alive else "Failover", cand_name, fl), ""]
    if b:
        return "\n".join(out + ["## Blockers", ""] + ["- " + x for x in b]) + "\n", False
    return "\n".join(out + [failover_runbook(fl, old_alive, cand_name, other_names)]) + "\n", True


# ---- backup ---------------------------------------------------------------------------------

def dir_bytes(path):
    return sum(os.path.getsize(os.path.join(b, f)) for b, _, fs in os.walk(path) for f in fs)


def backup_command(method, flavor, prof, cnf, target):
    host, port, user = prof.get("host", "127.0.0.1"), str(prof.get("port", 3306)), prof["user"]
    if method in ("xtrabackup", "mariabackup"):
        names = ["xtrabackup"] if method == "xtrabackup" else ["mariadb-backup", "mariabackup"]
        binary = next((shutil.which(n) for n in names if shutil.which(n)), None)
        if not binary:
            raise Fail("%s not found in PATH (run this on the database host)" % names[0])
        return [binary, "--defaults-extra-file=%s" % cnf, "--backup", "--target-dir=%s" % target,
                "--host=%s" % host, "--port=%s" % port, "--user=%s" % user]
    names = ["mariadb-dump", "mysqldump"] if flavor == "mariadb" else ["mysqldump"]
    binary = next((shutil.which(n) for n in names if shutil.which(n)), None)
    if not binary:
        raise Fail("%s not found in PATH" % names[0])
    gt = ["--master-data=2", "--gtid"] if flavor == "mariadb" else ["--source-data=2", "--set-gtid-purged=ON"]
    return [binary, "--defaults-extra-file=%s" % cnf, "--host=%s" % host, "--port=%s" % port, "--user=%s" % user,
            "--single-transaction", "--routines", "--events", "--triggers", "--all-databases"] + gt + ["--result-file=%s" % os.path.join(target, "dump.sql")]


def sha256_of(path):
    import hashlib
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def run_backup(name, method, target, dry_run=False):
    import datetime
    prof = get_profile(name)
    f = facts(prof)
    if method == "mariabackup" and f["flavor"] != "mariadb" or method == "xtrabackup" and f["flavor"] == "mariadb":
        raise Fail("%s does not fit a %s server" % (method, f["flavor"]))
    if os.path.exists(target) and (not os.path.isdir(target) or os.listdir(target)):
        raise Fail("target %s exists and is not an empty directory; backups never overwrite" % target)
    need = f["data_bytes"] * (1.1 if method != "dump" else 0.5)
    parent = os.path.dirname(os.path.abspath(target.rstrip("/"))) or "/"
    if not os.path.isdir(parent):
        raise Fail("parent directory %s does not exist" % parent)
    free = shutil.disk_usage(parent).free
    if free < need:
        raise Fail("not enough free space at %s: %s free, about %s needed" % (parent, human(free), human(need)))
    if dry_run:
        return "dry run: %s of data, %s free, would write to %s" % (human(f["data_bytes"]), human(free), target)
    os.makedirs(target, mode=0o700, exist_ok=True)
    pw = load_secrets().get(prof.get("secret", ""))
    if pw is None:
        raise Fail("profile %s needs a secret for backups" % name)
    d = os.path.join(HOME(), "tmp")
    os.makedirs(d, mode=0o700, exist_ok=True)
    fd, cnf = tempfile.mkstemp(dir=d, suffix=".cnf")
    started = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write('[client]\npassword="%s"\n' % pw.replace("\\", "\\\\").replace('"', '\\"'))
        r = subprocess.run(backup_command(method, f["flavor"], prof, cnf, target), capture_output=True, text=True)
    finally:
        if os.path.exists(cnf):
            os.unlink(cnf)
    if r.returncode:
        raise Fail("backup failed (target kept for inspection, do not use it): " + redact(r.stderr.strip()[-600:], [pw]))
    man = {"method": method, "flavor": f["flavor"], "version": f["version"], "started": started,
           "finished": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"), "bytes": dir_bytes(target)}
    if method == "dump":
        man["sha256"] = sha256_of(os.path.join(target, "dump.sql"))
    mfile = os.path.join(target, "backup-manifest.json")
    fd = os.open(mfile, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(man, fh, indent=2)
    return "backup finished: %s, %s at %s" % (method, human(man["bytes"]), target)


def verify_backup(target):
    problems = []
    mfile = os.path.join(target, "backup-manifest.json")
    if not os.path.isfile(mfile):
        return ["no backup-manifest.json: this backup was not made by mysql-tool or did not finish"], {}
    with open(mfile) as fh:
        man = json.load(fh)
    method = man.get("method")
    if method == "dump":
        dump = os.path.join(target, "dump.sql")
        if not os.path.isfile(dump):
            problems.append("dump.sql is missing")
        else:
            if sha256_of(dump) != man.get("sha256"):
                problems.append("dump.sql changed since the backup (sha256 differs)")
            with open(dump, "rb") as fh:
                fh.seek(max(0, os.path.getsize(dump) - 400))
                if b"Dump completed" not in fh.read():
                    problems.append("dump.sql does not end with 'Dump completed': it is truncated")
    else:
        cp = os.path.join(target, "xtrabackup_checkpoints")
        if not os.path.isfile(cp):
            problems.append("xtrabackup_checkpoints is missing")
        else:
            with open(cp) as fh:
                kv = dict(l.strip().split(" = ", 1) for l in fh if " = " in l)
            man["state"] = kv.get("backup_type")
            if kv.get("backup_type") not in ("full-backuped", "full-prepared"):
                problems.append("unexpected backup_type %r" % kv.get("backup_type"))
        if not os.path.isfile(os.path.join(target, "xtrabackup_binlog_info")):
            problems.append("xtrabackup_binlog_info is missing (the replication position)")
        if dir_bytes(target) < man.get("bytes", 0) * 0.99:
            problems.append("the backup is smaller than when it was made")
    return problems, man


# ---- cli ------------------------------------------------------------------------------------

def emit_rows(rs, as_json):
    if as_json:
        print(json.dumps(rs, indent=2))
    elif rs:
        print("\t".join(rs[0]))
        for r in rs:
            print("\t".join(r.values()))


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    for n in ("profiles", "secrets"):
        sub.add_parser(n)
    p = sub.add_parser("secret-set"); p.add_argument("name")
    p = sub.add_parser("secret-gen"); p.add_argument("name"); p.add_argument("--length", type=int, default=24); p.add_argument("--force", action="store_true")
    for n in ("info", "inspect", "replica-status"):
        p = sub.add_parser(n); p.add_argument("profile"); p.add_argument("--json", action="store_true"); p.add_argument("--max-lag", type=int, default=30)
    p = sub.add_parser("query"); p.add_argument("profile"); p.add_argument("sql"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("exec"); p.add_argument("profile"); p.add_argument("sql")
    p = sub.add_parser("plan-replica"); p.add_argument("--source", required=True); p.add_argument("--replica", required=True)
    p.add_argument("--method", required=True, choices=("xtrabackup", "mariabackup", "clone", "dump"))
    p = sub.add_parser("diagnose"); p.add_argument("replica"); p.add_argument("--source", required=True)
    p = sub.add_parser("plan-failover"); p.add_argument("--candidate", required=True); p.add_argument("--old-source"); p.add_argument("--other", action="append", default=[])
    p = sub.add_parser("backup"); p.add_argument("profile"); p.add_argument("--method", required=True, choices=("xtrabackup", "mariabackup", "dump"))
    p.add_argument("--target", required=True); p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("verify-backup"); p.add_argument("target")
    for n in ("audit-config", "audit-accounts", "locks", "upgrade-check"):
        p = sub.add_parser(n); p.add_argument("profile")
    p = sub.add_parser("slow-queries"); p.add_argument("profile"); p.add_argument("--limit", type=int, default=10)
    p = sub.add_parser("schema-diff"); p.add_argument("--a", required=True); p.add_argument("--b", required=True); p.add_argument("--schema")
    p = sub.add_parser("monitor"); p.add_argument("profiles", nargs="+"); p.add_argument("--max-lag", type=int, default=30)
    p = sub.add_parser("scan-secrets"); p.add_argument("paths", nargs="*")
    a = ap.parse_args(argv)
    try:
        if a.cmd == "profiles":
            for n, pr in sorted(load_profiles().items()):
                print("%s\t%s@%s:%s\tsecret=%s" % (n, pr.get("user"), pr.get("host", "127.0.0.1"), pr.get("port", 3306), pr.get("secret") or pr.get("login_path") or "-"))
        elif a.cmd == "secrets":
            for n in sorted(load_secrets()):
                print(n)
        elif a.cmd == "secret-set":
            store_secret(a.name, getpass.getpass("Value for %s (hidden): " % a.name))
            print("stored %s" % a.name)
        elif a.cmd == "secret-gen":
            alphabet = string.ascii_letters + string.digits
            store_secret(a.name, "".join(_secrets.choice(alphabet) for _ in range(max(16, a.length))), a.force)
            print("stored %s (generated, not shown)" % a.name)
        elif a.cmd == "info":
            f = facts(get_profile(a.profile))
            f.pop("ver")
            print(json.dumps(f, indent=2) if a.json else "%s %s (%s)\nsupported: %s\nserver_id=%s log_bin=%s gtid=%s data=%s" % (
                f["flavor"], f["version"], f["comment"], f["supported"], f["vars"].get("server_id"), f["vars"].get("log_bin"),
                f["vars"].get("gtid_mode") or "strict=" + str(f["vars"].get("gtid_strict_mode")), human(f["data_bytes"])))
        elif a.cmd == "inspect":
            print(inspect(get_profile(a.profile)))
        elif a.cmd == "replica-status":
            r = replica_status(get_profile(a.profile), a.max_lag)
            print(json.dumps(r, indent=2) if a.json else "%s\n%s" % (r["verdict"], "\n".join("- " + x for x in r["problems"])))
            return 0 if r["verdict"] in ("OK", "NONE") else 1
        elif a.cmd == "query":
            emit_rows(rows(run_sql(get_profile(a.profile), check_readonly(a.sql))), a.json)
        elif a.cmd == "exec":
            prof = get_profile(a.profile)
            for s in check_write(a.sql):
                print(redact(run_sql(prof, s, readonly=False)).strip() or "ok: %.40s" % re.sub(r"'[^']*'", "'..'", s))
        elif a.cmd == "plan-replica":
            text, ok = plan(a.source, a.replica, a.method)
            print(text)
            return 0 if ok else 1
        elif a.cmd == "diagnose":
            verdict, lines = diagnose(get_profile(a.replica), get_profile(a.source))
            print("%s\n%s" % (verdict, "\n".join("- " + x for x in lines)))
            return 0 if verdict in ("OK", "NONE") else 1
        elif a.cmd == "plan-failover":
            text, ok = plan_failover(a.candidate, a.old_source, a.other)
            print(text)
            return 0 if ok else 1
        elif a.cmd == "backup":
            print(run_backup(a.profile, a.method, a.target, a.dry_run))
        elif a.cmd == "verify-backup":
            problems, man = verify_backup(a.target)
            print("\n".join(["- " + x for x in problems]) or "backup looks complete (%s %s, %s)" % (man.get("method"), man.get("version"), human(man.get("bytes", 0))))
            if not problems:
                print("This checks the files only. Prove it restores by starting a scratch instance from it (see /dynamia-mysql:backup).")
            return 1 if problems else 0
        elif a.cmd == "audit-config":
            prof = get_profile(a.profile)
            f = facts(prof)
            res = audit_config(f["flavor"], all_vars(prof))
            print("\n".join("[%s] %s" % x for x in res) or "no findings")
        elif a.cmd == "audit-accounts":
            res = audit_accounts(account_rows(get_profile(a.profile)))
            print("\n".join("[%s] %s" % x for x in res) or "no findings")
        elif a.cmd == "slow-queries":
            for r in slow_queries(get_profile(a.profile), a.limit):
                print("%ss total, %s calls, avg %ss [%s] %s\n    %s" % (r["total_s"], r["calls"], r["avg_s"], r["db"], r["flags"] or "no flag", r["query"]))
        elif a.cmd == "locks":
            prof = get_profile(a.profile)
            res = locks(prof, facts(prof)["flavor"])
            print("## Open transactions (oldest first)")
            emit_rows(res["transactions"], False)
            print("\n## Lock waits")
            emit_rows(res["waits"], False)
            print("\n## Latest deadlock\n" + (res["deadlock"] or "none recorded"))
            print("\nThis tool never kills a session; the user decides about KILL <pid>.")
        elif a.cmd == "schema-diff":
            res = schema_diff(schema_snapshot(get_profile(a.a), a.schema), schema_snapshot(get_profile(a.b), a.schema), a.a, a.b)
            print("\n".join(res[:200]) + ("\n... %d more" % (len(res) - 200) if len(res) > 200 else "") if res else "schemas match (tables, columns, indexes)")
            return 1 if res else 0
        elif a.cmd == "upgrade-check":
            fl, ver, res = upgrade_check(get_profile(a.profile))
            print("%s %s\n%s" % (fl, ver, "\n".join("[%s] %s" % x for x in res)))
        elif a.cmd == "monitor":
            results = [monitor_one(n, a.max_lag) for n in a.profiles]
            print("\n".join(x[1] for x in results))
            return 0 if all(x[0] for x in results) else 1
        elif a.cmd == "scan-secrets":
            hits, notes = scan_secrets(a.paths)
            for path, n, kind in hits:
                print("%s:%d: %s" % (path, n, kind))
            for n in notes:
                print("note: " + n)
            print("%d finding(s); values are never printed" % len(hits))
            return 1 if hits or notes else 0
    except Fail as e:
        print("mysql-tool: %s" % e, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
